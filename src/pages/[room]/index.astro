---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Illustration from '../../components/Illustration.astro';
import Icon from '../../components/Icon.astro';
import { rooms, type ContentRoom } from '../../data/site';
import { getVisibleWorks } from '../../lib/content';
import Workshop from '../../components/rooms/Workshop.astro';
import ReadingRoom from '../../components/rooms/ReadingRoom.astro';
import Gallery from '../../components/rooms/Gallery.astro';
import Studio from '../../components/rooms/Studio.astro';
import Attic from '../../components/rooms/Attic.astro';
import Art from '../../components/Art.astro';
import CollectionFilters from '../../components/CollectionFilters.astro';
import Bookshelf from '../../components/Bookshelf.astro';
export function getStaticPaths() {
  return rooms.filter((room) => room.slug !== 'entrada').map((room) => ({ params: { room: room.slug }, props: { room } }));
}
const { room } = Astro.props;
const works = (await getVisibleWorks()).filter((work) => work.data.room === room.slug);
const artwork: Record<ContentRoom, 'cassette' | 'map' | 'portrait' | 'coffee' | 'window'> = { estudio: 'cassette', oficina: 'window', sotao: 'map', sala: 'coffee', galeria: 'portrait' };
---
<BaseLayout title={room.name} description={room.introduction} current={room.slug}>
  {room.slug === 'sotao' && <div class="attic-ceiling"><Art name="ceiling" eager /></div>}
  <div class="room-content">
    <header class:list={['room-heading', 'scene-heading', { 'scene-heading-sala': room.slug === 'sala' && works.length > 0 }]}><div><a class="back-link handwriting" href="/">← de volta à entrada</a><h1 class="painted room-title">{room.name.toLocaleLowerCase('pt-BR')}</h1></div><p class="room-introduction paper pinned">{room.introduction}</p>{room.slug === 'sala' && works.length > 0 && <Bookshelf works={works} />}</header>
    {works.length === 0 ? <section class="empty-room" aria-labelledby="room-note-title"><div class:list={['empty-illustration', `empty-${room.slug}`]}><Illustration kind={artwork[room.slug as ContentRoom]} /></div><div class="paper empty-note pinned"><span class="eyebrow handwriting">este canto está sendo arrumado</span><h2 id="room-note-title">Tudo tem<br />seu começo.</h2><p>{room.empty}</p><a class="text-link" href="/">Explorar a casa <Icon name="arrow" size={21} /></a></div></section> : <>
      {room.slug === 'oficina' && <Workshop works={works} />}
      {room.slug === 'sala' && <ReadingRoom works={works} />}
      {room.slug === 'galeria' && <Gallery works={works} />}
      {room.slug === 'estudio' && <Studio works={works} />}
      {room.slug === 'sotao' && <Attic works={works} />}
    </>}
  </div>
  <CollectionFilters />
</BaseLayout>
