---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Illustration from '../../components/Illustration.astro';
import Icon from '../../components/Icon.astro';
import { rooms, type ContentRoom } from '../../data/site';
import { getPublishedWorks, workHref } from '../../lib/content';
export function getStaticPaths() {
  return rooms.filter((room) => room.slug !== 'entrada').map((room) => ({ params: { room: room.slug }, props: { room } }));
}
const { room } = Astro.props;
const works = (await getPublishedWorks()).filter((work) => work.data.room === room.slug);
const tags = [...new Set(works.flatMap((work) => work.data.tags))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const artwork: Record<ContentRoom, 'cassette' | 'map' | 'portrait' | 'coffee' | 'window'> = { estudio: 'cassette', oficina: 'window', sotao: 'map', sala: 'coffee', galeria: 'portrait' };
---
<BaseLayout title={room.name} description={room.introduction} current={room.slug}>
  <div class="room-content">
    <header class="room-heading"><a class="back-link handwriting" href="/">← de volta à entrada</a><h1 class="painted room-title">{room.name.toLocaleLowerCase('pt-BR')}</h1><p class="room-introduction">{room.introduction}</p></header>
    {works.length === 0 ? <section class="empty-room" aria-labelledby="room-note-title"><div class:list={['empty-illustration', `empty-${room.slug}`]}><Illustration kind={artwork[room.slug as ContentRoom]} /></div><div class="paper empty-note pinned"><span class="eyebrow handwriting">este canto está sendo arrumado</span><h2 id="room-note-title">Tudo tem<br />seu começo.</h2><p>{room.empty}</p><a class="text-link" href="/">Explorar a casa <Icon name="arrow" size={21} /></a></div></section> : <section aria-label={`Trabalhos: ${room.name}`}>
      {tags.length > 1 && <div class="tag-filters" role="group" aria-label="Filtrar por assunto"><button type="button" class="tag-button" data-tag="" aria-pressed="true">Tudo</button>{tags.map((tag) => <button type="button" class="tag-button" data-tag={tag} aria-pressed="false">{tag}</button>)}</div>}
      <p class="filter-status handwriting" aria-live="polite" aria-atomic="true">{works.length} {works.length === 1 ? 'trabalho' : 'trabalhos'} por aqui</p>
      <div class="work-grid">{works.map((work) => <article class="work-card paper" data-work data-tags={JSON.stringify(work.data.tags)}>
        {work.data.image && <img class="work-thumbnail" src={work.data.image} alt={work.data.imageAlt} loading="lazy" width="600" height="420" />}
        <span class="eyebrow handwriting">{work.data.maturity ?? work.data.status ?? room.detail}</span><h2><a href={workHref(work)}>{work.data.title}</a></h2><p>{work.data.summary}</p><a class="text-link handwriting" href={workHref(work)}>ver de perto <Icon name="arrow" size={18} /></a>
      </article>)}</div>
    </section>}
  </div>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
    const items = document.querySelectorAll<HTMLElement>('[data-work]');
    const status = document.querySelector('.filter-status');
    filters.forEach((button) => button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      let visible = 0;
      filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
      items.forEach((item) => {
        const tags: string[] = JSON.parse(item.dataset.tags ?? '[]');
        item.hidden = tag !== '' && !tags.includes(tag);
        if (!item.hidden) visible++;
      });
      if (status) status.textContent = `${visible} ${visible === 1 ? 'trabalho' : 'trabalhos'} ${tag ? `sobre ${tag}` : 'por aqui'}`;
    }));
  </script>
</BaseLayout>
