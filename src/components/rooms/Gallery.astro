---
import Art from '../Art.astro';
import WorkVisual from '../WorkVisual.astro';
import FilterControls from '../FilterControls.astro';
import { workHref, type Work } from '../../lib/content';
interface Props { works: Work[]; }
const { works } = Astro.props;
const drawings = works.filter((work) => !work.data.category || work.data.category === 'Desenhos');
const studies = works.filter((work) => work.data.category === 'Estudos');
const photos = works.filter((work) => work.data.category === 'Fotografias');
const categories = [{ value: 'Desenhos', count: drawings.length }, { value: 'Estudos', count: studies.length }, { value: 'Fotografias', count: photos.length }].filter((category) => category.count > 0);
---
<div class="gallery-scene" data-room-scene="galeria" data-filter-scope>
  <FilterControls label="Explorar a galeria" kind="category" options={categories} /><p class="filter-status handwriting" data-filter-status aria-live="polite" aria-atomic="true">{works.length} trabalhos nesta parede</p>
  {drawings.length > 0 && <section class="gallery-section" data-filter-section><h2>Desenhos</h2><div class="gallery-rail" aria-hidden="true"></div><div class="framed-gallery">{drawings.map((work, index) => <a class:list={['framed-work', `frame-tone-${index % 3}`]} href={workHref(work)} data-work data-category="Desenhos"><span class="frame-cord" aria-hidden="true"></span><span class="art-frame">{work.data.image || work.data.artwork ? <WorkVisual work={work} /> : <span class="art-missing handwriting">obra em preparação</span>}</span><span class="paper frame-label handwriting">{work.data.title}<small>{work.data.medium}</small></span></a>)}</div></section>}
  {studies.length > 0 && <section class="gallery-section" data-filter-section><h2>Estudos</h2><div class="study-scene">{studies.map((work) => <a class="study-book" href={workHref(work)} data-work data-category="Estudos"><WorkVisual work={work} fallback="notebook" /><span class="text-link handwriting">{work.data.title} ↗</span></a>)}<aside class="easel-scene"><Art name="easel" /><p class="post-it handwriting">o caderno guarda o caminho, não só o desenho pronto.</p></aside></div></section>}
  {photos.length > 0 && <section class="gallery-section" data-filter-section><h2>Fotografias</h2><p class="handwriting scene-caption">o que cabe guardar de um instante</p><div class="photograph-line">{photos.map((work) => <a href={workHref(work)} class="polaroid" data-work data-category="Fotografias"><WorkVisual work={work} /><span class="handwriting">{work.data.title}</span></a>)}</div><div class="film-strip"><Art name="film" /><p class="handwriting">ainda tem espaço<br />para a próxima foto.</p></div></section>}
</div>
