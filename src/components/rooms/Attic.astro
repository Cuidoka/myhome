---
import Art from '../Art.astro';
import WorkVisual from '../WorkVisual.astro';
import CharacterCard from '../CharacterCard.astro';
import Icon from '../Icon.astro';
import { workHref, shortDate, type Work } from '../../lib/content';
interface Props { works: Work[]; }
const { works } = Astro.props;
const featured = works.find((work) => work.data.featured) ?? works[0]!;
const campaign = featured.data.campaign;
const chests = ['chest', 'chest-dark', 'chest-sage'] as const;
---
<div class="attic-scene" data-room-scene="sotao">
  <section class="campaign-wall" aria-labelledby="campaign-title"><div class="campaign-map"><span class="pin" aria-hidden="true"></span><WorkVisual work={featured} fallback="map" /></div><div class="campaign-info"><div class="lore-notes">{campaign?.lore.map((lore) => <aside class="paper lore-note"><span class="handwriting">{lore.kind}</span><h3>{lore.title}</h3><p>{lore.text}</p></aside>)}</div><article class="paper campaign-premise"><span class="eyebrow handwriting">{featured.data.status ?? 'um mundo em construção'}</span><h2 id="campaign-title">{featured.data.title}</h2><p>{featured.data.summary}</p>{campaign?.players && <p class="handwriting">{campaign.players} jogadores · {campaign.sessions.length} sessões neste diário</p>}<a class="text-link" href={workHref(featured)}>Ler do começo</a></article></div></section>
  {campaign && <section class="game-session" aria-label="A mesa de RPG"><p class="scene-caption handwriting">a mesa, do jeito que ficou no sábado</p><div class="game-table"><Art name="table" /><Art name="battlemap" class="table-battlemap" /><div class="table-dice" aria-hidden="true"><Icon name="dice" size={50} /><svg viewBox="0 0 50 50" width="35" height="35" fill="#fff8ed" stroke="#382a22" stroke-width="1.5"><path d="m25 3 21 22-21 22L4 25Z M4 25h42M25 3v44" /></svg><svg viewBox="0 0 40 40" width="31" height="31" fill="#d8c0a5" stroke="#382a22" stroke-width="1.5"><rect x="4" y="4" width="32" height="32" rx="2" /><circle cx="12" cy="12" r="2" fill="#382a22" /><circle cx="28" cy="28" r="2" fill="#382a22" /><circle cx="20" cy="20" r="2" fill="#382a22" /></svg></div><div class="character-cards">{campaign.characters.map((character) => <CharacterCard character={character} />)}</div></div></section>}
  <div class="scene-columns"><section class="paper session-diary" aria-labelledby="diary-title"><h2 id="diary-title">Diário de sessões</h2>{campaign && campaign.sessions.length > 0 ? <ol>{campaign.sessions.map((session) => <li><span class="handwriting">sessão {session.number}</span><div><a href={workHref(featured)}>{session.title}</a><p>{session.summary}</p></div><time datetime={session.date.toISOString()} class="handwriting">{shortDate(session.date)}</time></li>)}</ol> : <p>O diário começa junto com a primeira sessão.</p>}<a class="text-link" href={workHref(featured)}>Explorar este mundo</a></section><aside class="worlds-list"><h2>Outros mundos</h2><p class="handwriting scene-caption">cada baú é uma campanha</p><ul>{works.map((work, index) => <li><a href={workHref(work)}><Art name={chests[index % chests.length]!} /><span>{work.data.title}<small>{work.data.status ?? 'em construção'}</small></span></a></li>)}</ul></aside></div>
</div>
