---
import Art from '../Art.astro';
import TavernGenerator from '../TavernGenerator.astro';
import { workHref, type Work } from '../../lib/content';
interface Props { works: Work[]; }
const { works } = Astro.props;
const featured = works.find((work) => work.data.featured) ?? works[0]!;
---
<div class="workshop-scene" data-room-scene="oficina">
  <section class="pegboard" aria-labelledby="bench-title"><span class="object-label handwriting" id="bench-title">na bancada agora</span><div class="bench-feature">
    <div class="bench-window">{featured.data.interactive === 'tavern-name' ? <TavernGenerator preview={featured.data.previewOnly} /> : <div class="browser-window paper"><div class="browser-title">na bancada</div><div class="generator-body"><h2>{featured.data.title}</h2></div></div>}<div class="paper bench-description"><h2>{featured.data.title}</h2><p>{featured.data.summary}</p></div></div>
    <div class="bench-details"><pre class="dark-code"><code>{featured.data.snippet ?? `// ${featured.data.title}\n// ${featured.data.technologies.join(', ')}`}</code></pre><dl class="paper project-facts"><div><dt>Feito com</dt><dd>{featured.data.technologies.join(', ') || 'processo em aberto'}</dd></div><div><dt>Estado</dt><dd><span class="maturity">{featured.data.status ?? 'em andamento'}</span></dd></div></dl><div class="bench-links"><a class="sketch-button" href={workHref(featured)}>Ler como foi feito</a>{featured.data.source && <a class="sketch-button" href={featured.data.source}>Ver o código-fonte</a>}</div></div>
  </div><Art name="tools" class="tool-row" /><span class="tool-caption handwriting">as ferramentas de verdade</span></section>
  <div class="scene-columns"><section class="clipboard" aria-labelledby="projects-title"><Art name="clip" class="clipboard-clip" /><div class="paper clipboard-paper"><h2 id="projects-title">Todos os projetos</h2><div class="table-scroll" tabindex="0" role="region" aria-label="Projetos"><table class="project-table"><thead><tr><th>Projeto</th><th>O que faz</th><th>Feito com</th><th>Estado</th></tr></thead><tbody>{works.map((work) => <tr><th scope="row"><a href={workHref(work)}>{work.data.title}</a></th><td>{work.data.summary}</td><td>{work.data.technologies.join(', ')}</td><td><span class="maturity">{work.data.status ?? 'em andamento'}</span></td></tr>)}</tbody></table></div></div></section><aside class="spiral-notebook paper"><h2>anotações técnicas</h2><ul>{featured.data.notes.map((note) => <li>{note}</li>)}</ul><p class="handwriting">um problema de cada vez.</p></aside></div>
</div>
