---
import Art from '../Art.astro';
import { workHref, shortDate, duration, type Work } from '../../lib/content';
interface Props { works: Work[]; }
const { works } = Astro.props;
const featured = works.find((work) => work.data.featured) ?? works[0]!;
const collections = [...new Set(works.map((work) => work.data.collection ?? 'Composições soltas'))];
const tapes = ['cassette', 'cassette-clay', 'cassette-sage'] as const;
---
<div class="studio-scene" data-room-scene="estudio" data-filter-scope>
  <span class="scene-caption handwriting">em destaque no estúdio</span><section class="studio-feature" aria-labelledby="track-title"><div class="record-cover"><span class="tape" aria-hidden="true"></span>{featured.data.image ? <img src={featured.data.image} alt={featured.data.imageAlt} width="300" height="300" /> : <Art name={featured.data.artwork ?? 'cover'} />}</div><div class="paper record-description"><span class="eyebrow handwriting">{featured.data.collection}</span><h2 id="track-title">{featured.data.title}</h2>{featured.data.audio ? <audio controls preload="metadata" src={featured.data.audio} aria-label={`Ouvir ${featured.data.title}`}></audio> : <div class="audio-placeholder"><svg viewBox="0 0 440 50" aria-hidden="true"><path d="M0 25q8-28 16 0t32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0" fill="none" stroke="currentColor" stroke-width="2.5" /></svg><span class="handwriting">{duration(featured.data.durationSeconds)} · sem áudio anexado</span></div>}<p>{featured.data.summary}</p><a class="text-link" href={workHref(featured)}>Ler a história da faixa</a></div></section>
  <section class="tape-collection" aria-labelledby="tapes-title"><h2 id="tapes-title">Fitas</h2><p class="handwriting scene-caption">cada fita é uma coleção. clica pra folhear</p><div class="tape-grid">{collections.map((collection, index) => <button type="button" class="album-tape" data-filter data-kind="collection" data-value={collection} aria-pressed="false"><Art name={tapes[index % tapes.length]!} /><span class="album-name handwriting">{collection}</span><span class="tape-count handwriting">{works.filter((work) => (work.data.collection ?? 'Composições soltas') === collection).length} {works.filter((work) => (work.data.collection ?? 'Composições soltas') === collection).length === 1 ? 'faixa' : 'faixas'}</span></button>)}<aside class="post-it handwriting">um acorde, uma ideia,<br />um lugar para voltar.</aside></div></section>
  <div class="scene-columns"><section class="paper track-list pinned" aria-labelledby="tracks-title" id="faixas"><div class="list-heading"><h2 id="tracks-title">Todas as faixas</h2><button type="button" class="text-button handwriting" data-filter data-kind="collection" data-value="" aria-pressed="true">Ver todas</button></div><p class="filter-status handwriting" data-filter-status aria-live="polite" aria-atomic="true">{works.length} faixas no estúdio</p><div class="table-scroll" tabindex="0" role="region" aria-label="Faixas"><table><thead><tr><th>Faixa</th><th>Fita</th><th>Quando</th><th>Tempo</th></tr></thead><tbody>{works.map((work) => <tr data-work data-collection={work.data.collection ?? 'Composições soltas'}><th scope="row"><a href={workHref(work)}>{work.data.title}</a></th><td>{work.data.collection ?? 'Composições soltas'}</td><td>{shortDate(work.data.publishedAt)}</td><td>{duration(work.data.durationSeconds)}</td></tr>)}</tbody></table></div></section><aside class="process-notes"><h2 class="handwriting">caderno de processo</h2><div class="paper"><Art name="staff" /></div>{featured.data.notes.map((note) => <p class="post-it handwriting">{note}</p>)}</aside></div>
</div>
