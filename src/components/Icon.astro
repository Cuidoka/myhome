  {name === 'cassette' && <><rect x="2" y="7" width="28" height="19" rx="3" /><rect x="6" y="10" width="20" height="9" rx="4" /><circle cx="10" cy="14.5" r="2" /><circle cx="22" cy="14.5" r="2" /><path d="m9 26 2-5h10l2 5M13 14h6" /></>}
  {name === 'tools' && <><path d="m9 4 4 4-4 4-4-4 4-4ZM11 11l15 16M25 3a7 7 0 0 0-8 9L4 25l3 3 13-13a7 7 0 0 0 9-8l-5 5-4-4 5-5Z" /></>}
  {name === 'dice' && <><path d="m16 2 13 8v14l-13 7L3 24V10L16 2Zm0 0-9 21h18L16 2ZM3 10l13 3 13-3M3 24l4-1 9 8 9-8 4 1" /><path d="m13 19 2-2v5m3-5c4 0 4 5 0 5s-3-5 0-5Z" stroke-width="1" /></>}
