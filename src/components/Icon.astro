  {name === 'arrow' && <path d="M4 16h23m-8-8 8 8-8 8" />}
  {name === 'github' && <><path d="M12 27c-8 2-8-4-11-4m22 7v-6c0-2-1-3-2-4 5-1 8-3 8-8 0-2-1-4-2-5 0-2 0-4-1-5-3 0-5 2-5 2-4-1-7-1-10 0 0 0-3-2-5-2-1 1-1 3 0 5-2 1-3 3-3 5 0 5 3 7 8 8-1 1-2 2-2 4v6" transform="translate(2 0) scale(.9)" /></>}
</svg>
